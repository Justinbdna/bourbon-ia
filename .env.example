# ══════════════════════════════════════════════════════════════════════════
# Bourbon.IA — Fichier d'exemple des variables d'environnement (.env.example)
# Copiez ce fichier vers `.env` (qui est ignoré par Git) et adaptez les valeurs.
# ══════════════════════════════════════════════════════════════════════════

# ── 1. API CLOUD GROQ ──
# Clé d'API Groq pour l'inférence Cloud (utilisée si le mode Cloud est sélectionné ou en fallback)
GROQ_API_KEY=gsk_votre_cle_groq_ici

# ── 2. LLM LOCAL (LM Studio / Ollama) ──
# URL du serveur LLM local souverain compatible OpenAI
# - Mac local       : http://127.0.0.1:1234/v1
# - Réseau LAN/Ollama: http://127.0.0.1:11434/v1
LLM_API_URL=http://127.0.0.1:1234/v1

# ── 3. COMMUNICATION FRONTEND ↔ BACKEND ──
# URL du backend FastAPI interrogé par l'application React en développement
VITE_API_URL=http://localhost:8000

# ── 4. CONNECTEUR RAG ASSEMBLY (Tricoteuses) ──
# URL et timeout de l'API de données parlementaires
TRICOTEUSES_API_URL=https://parlement.tricoteuses.fr
TRICOTEUSES_TIMEOUT=30
