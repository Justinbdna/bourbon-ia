# ══════════════════════════════════════════════════════════════════════════
# Bourbon.IA — Fichier d'exemple des variables d'environnement (.env.example)
# Copiez ce fichier vers `.env` (ignoré par Git) et adaptez les valeurs.
# ══════════════════════════════════════════════════════════════════════════

# ── 1. SOUVERAINETÉ & MODE AIR-GAP ──
# 0 = mode Air-Gap strict (recommandé par défaut) : aucun appel réseau sortant
#     pour récupérer des textes de loi ou métadonnées ; seuls les référentiels
#     locaux (api/data/ et data/bourbon_rag.db) sont utilisés.
# 1 = autorise le fallback lecture seule vers l'API Open Data Tricoteuses.
BOURBON_TEXTES_DISTANTS=0

# ── 2. BASE SQLITE PERSISTANTE (RAG, 384 RÈGLES, HATVP, DEBUNKER) ──
# Chemin vers la base SQLite locale. Sous Vercel Serverless (VERCEL=1) ou si
# le dossier parent est en lecture seule, bascule automatiquement sur /tmp/bourbon_rag.db.
BOURBON_DB_PATH=data/bourbon_rag.db

# Plafond maximal d'amendements accepté par l'API et la file de jobs batch GPU
BOURBON_MAX_AMENDEMENTS=25000

# ── 3. EMBEDDINGS LOCAUX & LLM SOUVERAIN (OLLAMA / LM STUDIO) ──
# Endpoint local compatible OpenAI pour les embeddings RAG (/v1/embeddings).
# Si aucun serveur d'embeddings n'est démarré, Bourbon.IA bascule sur le
# scoring lexical hybride BM25 / TF-IDF hors-ligne.
# - Ollama    : http://127.0.0.1:11434/v1  (modèle recommandé : bge-m3)
# - LM Studio : http://127.0.0.1:1234/v1   (modèle : text-embedding-nomic-embed-text-v1.5)
BOURBON_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/v1
BOURBON_EMBEDDING_MODEL=bge-m3

# Endpoint local compatible OpenAI pour l'inférence LLM à la demande
LLM_API_URL=http://127.0.0.1:1234/v1

# Paramètres Ollama pour le contrôle de surtransposition UE (optionnel)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=mistral

# ── 4. COMMUNICATION FRONTEND ↔ BACKEND ──
# URL du backend FastAPI interrogé par l'application React en développement
VITE_API_URL=http://localhost:8000
# Fournisseur d'IA par défaut : « local » pour un déploiement souverain interne.
VITE_AI_PROVIDER_DEFAUT=local

# ── 5. CONNECTEURS OPEN DATA (OPTIONNELS, LECTURE SEULE SI DISTANT=1) ──
TRICOTEUSES_API_URL=https://parlement.tricoteuses.fr
TRICOTEUSES_TIMEOUT=30
# Identifiants PISTE / Légifrance pour scripts d'ingestion publics uniquement
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# ── 6. MODE DÉMO PUBLIQUE UNIQUEMENT (JAMAIS SUR AMENDEMENTS CONFIDENTIELS) ──
# Laisser vide en usage souverain/Air-Gap. Utilisé uniquement pour la démo publique
# sur des amendements déjà publiés, après consentement explicite de l'utilisateur.
GROQ_API_KEY=
GROQ_MODEL=
